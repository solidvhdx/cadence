#include <winver.h>

#ifndef CADENCE_VERSION_MAJOR
#define CADENCE_VERSION_MAJOR 1
#endif
#ifndef CADENCE_VERSION_MINOR
#define CADENCE_VERSION_MINOR 0
#endif
#ifndef CADENCE_VERSION_PATCH
#define CADENCE_VERSION_PATCH 5
#endif

#define CADENCE_RC_STRINGIFY_IMPL(x) #x
#define CADENCE_RC_STRINGIFY(x)      CADENCE_RC_STRINGIFY_IMPL(x)
#define CADENCE_RC_VER3(a, b, c)     CADENCE_RC_STRINGIFY(a.b.c)
#define CADENCE_RC_VER4(a, b, c, d)  CADENCE_RC_STRINGIFY(a.b.c.d)

101 ICON "cadence.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    CADENCE_VERSION_MAJOR,CADENCE_VERSION_MINOR,CADENCE_VERSION_PATCH,0
 PRODUCTVERSION CADENCE_VERSION_MAJOR,CADENCE_VERSION_MINOR,CADENCE_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Solid"
            VALUE "FileDescription",  "Cadence - High-Precision Mouse CPS & Keyboard KPS Engine"
            VALUE "FileVersion",      CADENCE_RC_VER4(CADENCE_VERSION_MAJOR, CADENCE_VERSION_MINOR, CADENCE_VERSION_PATCH, 0)
            VALUE "InternalName",     "Cadence"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Solid"
            VALUE "OriginalFilename", "Cadence.exe"
            VALUE "ProductName",      "Cadence"
            VALUE "ProductVersion",   CADENCE_RC_VER3(CADENCE_VERSION_MAJOR, CADENCE_VERSION_MINOR, CADENCE_VERSION_PATCH)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
